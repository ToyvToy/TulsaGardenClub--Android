<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/home"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:context=".HomePageView">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="95dp"
            android:elevation="4dp"
            android:background="@color/green"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/viewAccount"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:src="@drawable/baseline_account_circle_24"/>

        </androidx.appcompat.widget.Toolbar>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/infoCard1"
            android:layout_width="375dp"
            android:layout_height="285dp"
            android:layout_marginTop="35dp"
            app:layout_constraintTop_toBottomOf="@id/toolbar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:backgroundTint="@color/lightGreen">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/program_description"
                android:padding="8dp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:textSize="22sp"
                android:fontFamily="@font/cause"/>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/infoCard2"
            android:layout_width="375dp"
            android:layout_height="500dp"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/infoCard1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:backgroundTint="@color/lightGreen">

        </com.google.android.material.card.MaterialCardView>

        <Button
            android:layout_width="250dp"
            android:layout_height="match_parent"
            android:layout_marginTop="8dp"
            android:text="@string/view_events"
            app:layout_constraintTop_toBottomOf="@id/infoCard2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:fontFamily="@font/cause"
            android:textStyle="bold"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
